# Runtime connection. Use Supabase Session Pooler (port 5432) for Render.
NODE_ENV="production"
HOST="0.0.0.0"
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Prisma CLI and migrations. Use a direct or Supabase Session Pooler connection.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Dedicated backend administrator authentication.
SLYCE_ADMIN_EMAILS="timothypererat2004@gmail.com"
# Seed-only values. Supply securely only while running `pnpm --filter @slyce/backend admin:seed`.
SLYCE_ADMIN_SEED_EMAIL="timothypererat2004@gmail.com"
SLYCE_ADMIN_SEED_PASSWORD="SlyceOnCelo2026"
# Optional Celo RPC and GoodDollar Identity contract used for on-chain verification observations.
GOODDOLLAR_RPC_URL="https://forno.celo.org"
GOODDOLLAR_ENV="development"
GOODDOLLAR_IDENTITY_ADDRESS="0x0000000000000000000000000000000000000000"
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS="https://your-production-frontend.example"
MAX_REQUEST_BYTES="1048576"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
