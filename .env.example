# Copy to apps/web/.env.local (and set the same values in Vercel). Public values are embedded at build time.
# Empty public integration settings keep wallet/contract features unavailable.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GoodDollar runs on Celo mainnet only: use celo. An explicit HTTP(S) RPC URL is required.
NEXT_PUBLIC_NETWORK=
NEXT_PUBLIC_RPC_URL=
# Reown project ID (cloud.reown.com). Enable Email login there and allowlist your domain.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# production (real G$) or development (test G$). NEXT_PUBLIC_GD_ADDRESS must be that environment's token
# (docs/research/gooddollar.md).
NEXT_PUBLIC_GOODDOLLAR_ENV=
NEXT_PUBLIC_GD_ADDRESS=
# From contracts/script/Deploy.s.sol output. No defaults.
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_TOURNAMENT_ADDRESS=
NEXT_PUBLIC_ARCADE_ADDRESS=
# Future server adapters only; never prefix these with NEXT_PUBLIC_.
DATABASE_URL=
SESSION_SECRET=
RESULTS_SIGNER_PRIVATE_KEY=
